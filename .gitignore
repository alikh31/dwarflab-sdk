# Dependencies
node_modules/

# Build output (regenerated by `npm run build`; published to npm, not git)
dist/
packages/*/dist/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Coverage / test output
coverage/
.nyc_output/
*.tsbuildinfo

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*~

# Env / secrets
.env
.env.*
!.env.example

# Misc
tmp/
.cache/

# Note: packages/sdk/src/generated/ IS committed on purpose — the protobuf
# bindings are checked in so consumers can build without the proto toolchain.
# Regenerate with `npm run proto:generate`.
