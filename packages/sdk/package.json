{
  "name": "@alikh/dwarflab-sdk",
  "version": "0.1.0",
  "description": "Unofficial TypeScript SDK for controlling DWARFLAB DWARF telescopes over WebSocket and HTTP (browser + Node.js)",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "./dist/index.mjs",
    "./dist/index.cjs"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "long": "^5.3.2",
    "protobufjs": "^7.4.0"
  },
  "peerDependencies": {
    "ws": "^8.18.0"
  },
  "peerDependenciesMeta": {
    "ws": {
      "optional": true
    }
  },
  "keywords": [
    "dwarflab",
    "dwarf",
    "dwarf3",
    "telescope",
    "astronomy",
    "astrophotography",
    "smart-telescope",
    "sdk"
  ],
  "license": "MIT",
  "author": "alikh31",
  "homepage": "https://github.com/alikh31/dwarflab-sdk/tree/main/packages/sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alikh31/dwarflab-sdk.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/alikh31/dwarflab-sdk/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
