{
  "name": "dwarflab-sdk-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo for the unofficial DWARFLAB telescope TypeScript SDK",
  "license": "MIT",
  "author": "alikh31",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alikh31/dwarflab-sdk.git"
  },
